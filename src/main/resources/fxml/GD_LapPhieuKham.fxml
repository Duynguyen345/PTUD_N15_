<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="vn.nhom15.nhakhoa.gui.GD_LapPhieuKham_Controller" prefWidth="760" prefHeight="480">
    <top><Label text="UC003 — Lập phiếu khám (cấp STT, hàng chờ)" style="-fx-font-size: 16px; -fx-font-weight: bold;"
                styleClass="header"/></top>
    <center>
        <GridPane hgap="10" vgap="10" styleClass="center-pane">
            <Label text="Mã BN / SĐT" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="txt_timBN" prefWidth="200" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            <Button fx:id="btn_tim" text="Tìm" onAction="#tim" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
            <Label text="Bệnh nhân" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <Label fx:id="lb_bn" text="(chưa chọn)" GridPane.rowIndex="1" GridPane.columnIndex="1"
                   GridPane.columnSpan="2" style="-fx-font-weight: bold;"/>
            <Label text="Hóa đơn phí" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <Label fx:id="lb_hoaDon" text="(chưa có - hãy dùng màn hình Thu phí)" wrapText="true"
                   GridPane.rowIndex="2" GridPane.columnIndex="1" GridPane.columnSpan="2"/>
            <Label text="Bác sĩ" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <ComboBox fx:id="cbb_bacSi" prefWidth="280" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            <Label text="Phòng khám" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <ComboBox fx:id="cbb_phong" prefWidth="280" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
            <Label text="Lý do khám*" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
            <TextField fx:id="txt_lyDoKham" prefWidth="280" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
            <Label text="STT dự kiến" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
            <Label fx:id="lb_sttDuKien" GridPane.rowIndex="6" GridPane.columnIndex="1"
                   style="-fx-font-weight: bold; -fx-text-fill: #1F618D;"/>
            <HBox spacing="10" GridPane.rowIndex="7" GridPane.columnIndex="0" GridPane.columnSpan="3">
                <Button fx:id="btn_lapPhieu" text="Lập phiếu" onAction="#lapPhieu" defaultButton="true"/>
                <Button fx:id="btn_in" text="Xem phiếu" onAction="#inPhieu"/>
            </HBox>
        </GridPane>
    </center>
</BorderPane>
