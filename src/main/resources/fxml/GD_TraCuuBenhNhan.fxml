<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="vn.nhom15.nhakhoa.gui.GD_TraCuuBenhNhan_Controller" prefWidth="960" prefHeight="620">
    <top>
        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="header">
            <Label text="UC006 — Tra cứu hồ sơ bệnh nhân" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="10" styleClass="center-pane">
            <HBox spacing="8" alignment="CENTER_LEFT">
                <ComboBox fx:id="cbb_tieuChi" prefWidth="120"/>
                <TextField fx:id="txt_tuKhoa" prefWidth="260" promptText="Nhập từ khóa"/>
                <Button fx:id="btn_tim" text="Tìm" onAction="#tim" defaultButton="true"/>
            </HBox>
            <TableView fx:id="table_ketQua" prefHeight="430">
                <columns>
                    <TableColumn fx:id="cl_stt" text="STT" prefWidth="50"/>
                    <TableColumn fx:id="cl_ma" text="Mã BN" prefWidth="130"/>
                    <TableColumn fx:id="cl_hoTen" text="Họ tên" prefWidth="180"/>
                    <TableColumn fx:id="cl_sdt" text="SĐT" prefWidth="110"/>
                    <TableColumn fx:id="cl_tienSu" text="Tiền sử dị ứng" prefWidth="220"/>
                </columns>
            </TableView>
            <Label text="Double-click một dòng để xem chi tiết hồ sơ + lịch sử phiếu khám."/>
        </VBox>
    </center>
</BorderPane>
