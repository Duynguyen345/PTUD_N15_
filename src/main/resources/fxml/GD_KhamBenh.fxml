<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="vn.nhom15.nhakhoa.gui.GD_KhamBenh_Controller" prefWidth="1180" prefHeight="700">
    <top>
        <HBox spacing="12" alignment="CENTER_LEFT" styleClass="header">
            <Label text="UC004 — Ghi nhận khám và chẩn đoán" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
            <Button fx:id="btn_taiLai" text="Tải lại danh sách" onAction="#taiLai"/>
        </HBox>
    </top>
    <left>
        <VBox spacing="8" styleClass="center-pane" prefWidth="400">
            <Label text="Danh sách khám của tôi hôm nay" style="-fx-font-weight: bold;"/>
            <TableView fx:id="table_danhSach" prefHeight="380">
                <columns>
                    <TableColumn fx:id="cl_stt" text="STT" prefWidth="50"/>
                    <TableColumn fx:id="cl_ma" text="Mã phiếu" prefWidth="120"/>
                    <TableColumn fx:id="cl_bn" text="Bệnh nhân" prefWidth="140"/>
                    <TableColumn fx:id="cl_tt" text="Trạng thái" prefWidth="90"/>
                </columns>
            </TableView>
            <Label fx:id="lb_tienSu" wrapText="true" style="-fx-text-fill: #7D3C98;"/>
        </VBox>
    </left>
    <center>
        <VBox spacing="8" styleClass="center-pane">
            <GridPane hgap="8" vgap="8">
                <Label text="Bệnh nhân" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <Label fx:id="lb_bn" text="(chưa chọn)" GridPane.rowIndex="0" GridPane.columnIndex="1"
                       style="-fx-font-weight: bold;"/>
                <Label text="Chẩn đoán*" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextArea fx:id="ta_chanDoan" prefWidth="520" prefHeight="60" GridPane.rowIndex="2"
                          GridPane.columnIndex="0" GridPane.columnSpan="2"/>
                <Label text="Kết quả điều trị" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <TextField fx:id="txt_ketQua" prefWidth="520" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                <Label text="Thuốc tự mua (ghi chú)" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <TextField fx:id="txt_thuocTuMua" prefWidth="520" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
            </GridPane>
            <Label text="CHỈ ĐỊNH DỊCH VỤ (bắt buộc ít nhất 1)" style="-fx-font-weight: bold;"/>
            <HBox spacing="8">
                <ComboBox fx:id="cbb_dichVu" prefWidth="320"/>
                <Button fx:id="btn_themChiDinh" text="Thêm chỉ định" onAction="#themChiDinh"/>
                <Button fx:id="btn_xoaChiDinh" text="Xóa dòng chọn" onAction="#xoaChiDinh"/>
            </HBox>
            <TableView fx:id="table_chiDinh" prefHeight="120">
                <columns>
                    <TableColumn fx:id="cl_dv" text="Dịch vụ" prefWidth="280"/>
                    <TableColumn fx:id="cl_gia" text="Đơn giá niêm yết" prefWidth="140"/>
                </columns>
            </TableView>
            <Label text="CẤP THUỘC (không bắt buộc)" style="-fx-font-weight: bold;"/>
            <HBox spacing="8">
                <ComboBox fx:id="cbb_thuoc" prefWidth="280"/>
                <TextField fx:id="txt_soLuong" prefWidth="70" promptText="SL"/>
                <TextField fx:id="txt_ghiChuCap" prefWidth="180" promptText="Ghi chú liều"/>
                <Button fx:id="btn_themThuoc" text="Thêm thuốc" onAction="#themThuoc"/>
                <Button fx:id="btn_xoaThuoc" text="Xóa dòng chọn" onAction="#xoaThuoc"/>
            </HBox>
            <TableView fx:id="table_thuoc" prefHeight="110">
                <columns>
                    <TableColumn fx:id="cl_tenThuoc" text="Thuốc" prefWidth="240"/>
                    <TableColumn fx:id="cl_soLuongThuoc" text="Số lượng" prefWidth="80"/>
                    <TableColumn fx:id="cl_ghiChuThuoc" text="Ghi chú" prefWidth="240"/>
                </columns>
            </TableView>
            <HBox spacing="10">
                <Button fx:id="btn_luu" text="Lưu (vẫn đang khám)" onAction="#luu" defaultButton="true"/>
                <Button fx:id="btn_hoanTat" text="Hoàn tất lượt khám" onAction="#hoanTat"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
