<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="vn.nhom15.nhakhoa.gui.GD_QLDichVu_Controller" prefWidth="980" prefHeight="600">
    <top><Label text="UC007 — Quản lý danh mục dịch vụ" style="-fx-font-size: 16px; -fx-font-weight: bold;"
                styleClass="header"/></top>
    <left>
        <GridPane hgap="8" vgap="8" styleClass="center-pane">
            <Label text="Tên dịch vụ*" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="txt_tenDichVu" prefWidth="220" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            <Label text="Đơn giá niêm yết*" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="txt_donGia" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            <Label text="Trạng thái" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <ComboBox fx:id="cbb_trangThai" prefWidth="220" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            <HBox spacing="8" GridPane.rowIndex="3" GridPane.columnIndex="0" GridPane.columnSpan="2">
                <Button fx:id="btn_them" text="Thêm" onAction="#them" defaultButton="true"/>
                <Button fx:id="btn_sua" text="Sửa giá/tên" onAction="#sua"/>
                <Button fx:id="btn_doiTT" text="Đổi trạng thái" onAction="#doiTrangThai"/>
                <Button fx:id="btn_lamMoi" text="Làm mới" onAction="#lamMoi"/>
            </HBox>
            <Label text="Không có nút xóa cứng: dịch vụ hết dùng chỉ chuyển NGUNG_PHUC_VU."
                   wrapText="true" prefWidth="230" GridPane.rowIndex="4" GridPane.columnIndex="0"
                   GridPane.columnSpan="2"/>
        </GridPane>
    </left>
    <center>
        <VBox spacing="8" styleClass="center-pane">
            <TableView fx:id="table_dichVu" prefHeight="460">
                <columns>
                    <TableColumn fx:id="cl_stt" text="STT" prefWidth="50"/>
                    <TableColumn fx:id="cl_ma" text="Mã DV" prefWidth="90"/>
                    <TableColumn fx:id="cl_ten" text="Tên dịch vụ" prefWidth="220"/>
                    <TableColumn fx:id="cl_gia" text="Đơn giá" prefWidth="120"/>
                    <TableColumn fx:id="cl_tt" text="Trạng thái" prefWidth="120"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
