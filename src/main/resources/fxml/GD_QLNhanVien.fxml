<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="vn.nhom15.nhakhoa.gui.GD_QLNhanVien_Controller" prefWidth="1080" prefHeight="660">
    <top><Label text="UC010 — Quản lý nhân viên &amp; tài khoản" style="-fx-font-size: 16px; -fx-font-weight: bold;"
                styleClass="header"/></top>
    <left>
        <GridPane hgap="8" vgap="8" styleClass="center-pane">
            <Label text="Họ tên*" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="txt_hoTen" prefWidth="220" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            <Label text="SĐT*" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="txt_sdt" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            <Label text="Ngày sinh" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <DatePicker fx:id="dp_ngaySinh" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            <Label text="Giới tính" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <ComboBox fx:id="cbb_gioiTinh" prefWidth="220" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            <Label text="CCCD" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <TextField fx:id="txt_cccd" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
            <Label text="Chức vụ*" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
            <ComboBox fx:id="cbb_chucVu" prefWidth="220" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
            <HBox spacing="8" GridPane.rowIndex="6" GridPane.columnIndex="0" GridPane.columnSpan="2">
                <Button fx:id="btn_them" text="Thêm" onAction="#them" defaultButton="true"/>
                <Button fx:id="btn_sua" text="Sửa" onAction="#sua"/>
                <Button fx:id="btn_xoa" text="Xóa" onAction="#xoa"/>
                <Button fx:id="btn_lamMoi" text="Làm mới" onAction="#lamMoi"/>
            </HBox>
            <Label text="TÀI KHOẢN" GridPane.rowIndex="7" GridPane.columnIndex="0"
                   style="-fx-font-weight: bold;"/>
            <Label text="Tên đăng nhập" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
            <TextField fx:id="txt_tenDangNhap" GridPane.rowIndex="8" GridPane.columnIndex="1"/>
            <Label text="Mật khẩu" GridPane.rowIndex="9" GridPane.columnIndex="0"/>
            <TextField fx:id="txt_matKhau" GridPane.rowIndex="9" GridPane.columnIndex="1"/>
            <HBox spacing="8" GridPane.rowIndex="10" GridPane.columnIndex="0" GridPane.columnSpan="2">
                <Button fx:id="btn_taoTk" text="Tạo tài khoản (cho dòng chọn)" onAction="#taoTaiKhoan"/>
                <Button fx:id="btn_khoaMo" text="Khóa/Mở tài khoản" onAction="#khoaMo"/>
            </HBox>
        </GridPane>
    </left>
    <center>
        <VBox spacing="8" styleClass="center-pane">
            <TableView fx:id="table_nhanVien" prefHeight="520">
                <columns>
                    <TableColumn fx:id="cl_stt" text="STT" prefWidth="50"/>
                    <TableColumn fx:id="cl_ma" text="Mã NV" prefWidth="130"/>
                    <TableColumn fx:id="cl_hoTen" text="Họ tên" prefWidth="160"/>
                    <TableColumn fx:id="cl_sdt" text="SĐT" prefWidth="105"/>
                    <TableColumn fx:id="cl_chucVu" text="Chức vụ" prefWidth="90"/>
                    <TableColumn fx:id="cl_lamViec" text="Còn làm" prefWidth="70"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
