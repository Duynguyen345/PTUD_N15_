<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="vn.nhom15.nhakhoa.gui.GD_HangCho_Controller" prefWidth="1000" prefHeight="640">
    <top>
        <HBox spacing="12" alignment="CENTER_LEFT" styleClass="header">
            <Label text="UC009 — Theo dõi hàng chờ" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
            <ComboBox fx:id="cbb_phong" prefWidth="240"/>
            <Button fx:id="btn_taiLai" text="Tải lại" onAction="#taiLai"/>
            <Label fx:id="lb_soDangGoi" text="—" style="-fx-font-size: 26px; -fx-font-weight: bold;"/>
            <Label fx:id="lb_phongDangGoi" style="-fx-font-size: 14px;"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="8" styleClass="center-pane">
            <Label text="HÀNG CHỜ (CHO_KHAM)" style="-fx-font-weight: bold;"/>
            <TableView fx:id="table_hangCho" prefHeight="220">
                <columns>
                    <TableColumn fx:id="cl_stt" text="STT" prefWidth="60"/>
                    <TableColumn fx:id="cl_ma" text="Mã phiếu" prefWidth="140"/>
                    <TableColumn fx:id="cl_bn" text="Bệnh nhân" prefWidth="180"/>
                    <TableColumn fx:id="cl_lyDo" text="Lý do khám" prefWidth="240"/>
                    <TableColumn fx:id="cl_tt" text="Trạng thái" prefWidth="100"/>
                </columns>
            </TableView>
            <Label text="ĐANG KHÁM (DANG_KHAM)" style="-fx-font-weight: bold;"/>
            <TableView fx:id="table_dangKham" prefHeight="160">
                <columns>
                    <TableColumn fx:id="cl_stt2" text="STT" prefWidth="60"/>
                    <TableColumn fx:id="cl_ma2" text="Mã phiếu" prefWidth="140"/>
                    <TableColumn fx:id="cl_bn2" text="Bệnh nhân" prefWidth="180"/>
                    <TableColumn fx:id="cl_lyDo2" text="Lý do khám" prefWidth="240"/>
                </columns>
            </TableView>
            <HBox spacing="10">
                <Button fx:id="btn_goSo" text="Gọi số" onAction="#goiSo"/>
                <Button fx:id="btn_xacNhanVaoKham" text="Xác nhận vào khám" onAction="#xacNhanVaoKham"/>
            </HBox>
        </VBox>
    </center>
    <bottom>
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="center-pane">
            <Label text="PT-05 Quản lý phòng (bật/tắt nhận bệnh):"/>
            <ComboBox fx:id="cbb_allPhong" prefWidth="220"/>
            <Button fx:id="btn_bat" text="Bật nhận bệnh" onAction="#batNhanBenh"/>
            <Button fx:id="btn_tat" text="Tắt nhận bệnh" onAction="#tatNhanBenh"/>
        </HBox>
    </bottom>
</BorderPane>
