<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="gui.GD_ThanhToan_Controller" prefWidth="1020" prefHeight="640">
    <top>
        <HBox styleClass="header" alignment="CENTER_LEFT" spacing="14">
            <Button text="←  Quay lại" onAction="#quayLai" styleClass="back-btn"/>
            <Label text="Thanh toán dịch vụ cuối lượt" styleClass="page-title"/>
        </HBox>
    </top>
    <left>
        <VBox spacing="8" styleClass="center-pane" prefWidth="420">
            <Label text="Lượt khám đã HOAN_TAT — chờ thanh toán" styleClass="card-title"/>
            <TableView fx:id="table_phieu" prefHeight="400" VBox.vgrow="ALWAYS">
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                <columns>
                    <TableColumn fx:id="cl_ma" text="Mã phiếu" prefWidth="130"/>
                    <TableColumn fx:id="cl_bn" text="Bệnh nhân" prefWidth="170"/>
                    <TableColumn fx:id="cl_ngay" text="Ngày khám" prefWidth="100"/>
                </columns>
            </TableView>
            <Label text="Dịch vụ chi định của lượt khám được tính tiền khi bác sĩ đã HOAN_TAT." wrapText="true" styleClass="hint-text"/>
        </VBox>
    </left>
    <center>
        <VBox spacing="10" styleClass="center-pane">
            <VBox styleClass="card" spacing="8">
                <Label text="CHI TIẾT LƯỢT KHÁM" styleClass="card-title"/>
                <Label fx:id="lb_thongTin" text="(chưa chọn lượt khám)" style="-fx-font-weight: bold;"/>
                <TableView fx:id="table_dichVu" prefHeight="180" VBox.vgrow="ALWAYS">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="cl_dv" text="Dịch vụ đã chỉ định" prefWidth="260"/>
                        <TableColumn fx:id="cl_gia" text="Đơn giá" prefWidth="130"/>
                    </columns>
                </TableView>
                <HBox spacing="20" alignment="CENTER_RIGHT">
                    <Label text="TỔNG TIỀN:" styleClass="card-title"/>
                    <Label fx:id="lb_tong" text="0 ₫" styleClass="big-date"/>
                </HBox>
            </VBox>
            <VBox styleClass="card" spacing="8">
                <Label text="THANH TOÁN" styleClass="card-title"/>
                <GridPane hgap="10" vgap="8">
                    <Label text="Hình thức" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="cbb_hinhThuc" prefWidth="200" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                    <Label text="Tiền khách đưa" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="txt_tienDua" prefWidth="200" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    <Label text="Tiền thừa" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <Label fx:id="lb_tienThua" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                </GridPane>
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Button fx:id="btn_thanhToan" text="Xác nhận thanh toán" onAction="#thanhToan" defaultButton="true" styleClass="btn-primary"/>
                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>
