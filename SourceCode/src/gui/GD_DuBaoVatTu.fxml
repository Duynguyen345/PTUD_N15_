<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="gui.GD_DuBaoVatTu_Controller" prefWidth="980" prefHeight="640">
    <top>
        <HBox styleClass="header" alignment="CENTER_LEFT" spacing="14">
            <Button text="←  Quay lại" onAction="#quayLai" styleClass="back-btn"/>
            <Label text="AI dự báo vật tư nha khoa (2 tuần tới)" styleClass="page-title"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="10" styleClass="center-pane">
            <VBox styleClass="card" spacing="8">
                <Label text="DỰ BÁO DỰA TRÊN LƯỢT KHÁM &amp; DỊCH VỤ ĐÃ CHỈ ĐỊNH TRONG 30 NGÀY QUA" styleClass="card-title"/>
                <Label text="Cách tính: (lượng dùng trung bình mỗi ngày × 14 ngày) × hệ số dự phòng 10%. Đây chỉ là ước tính để tham khảo." styleClass="hint-text" wrapText="true"/>
                <Button text="Chạy dự báo" onAction="#chayDuBao" styleClass="btn-primary"/>
            </VBox>
            <VBox styleClass="card" spacing="8" VBox.vgrow="ALWAYS">
                <TableView fx:id="table_duBao" prefHeight="360" VBox.vgrow="ALWAYS">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="cl_vatTu" text="Vật tư" prefWidth="240"/>
                        <TableColumn fx:id="cl_daDung" text="Đã dùng 30 ngày" prefWidth="160"/>
                        <TableColumn fx:id="cl_duBao" text="Dự báo 2 tuần tới" prefWidth="160"/>
                        <TableColumn fx:id="cl_ghiChu" text="Ghi chú" prefWidth="240"/>
                    </columns>
                </TableView>
                <Label text="Nhân viên kho vẫn quyết định và thực hiện nhập hàng — dự báo chỉ để tham khảo." styleClass="hint-text"/>
            </VBox>
        </VBox>
    </center>
</BorderPane>
