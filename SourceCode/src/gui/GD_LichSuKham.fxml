<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="gui.GD_LichSuKham_Controller" prefWidth="1080" prefHeight="660">
    <top>
        <HBox styleClass="header" alignment="CENTER_LEFT" spacing="14">
            <Button text="←  Quay lại" onAction="#quayLai" styleClass="back-btn"/>
            <Label text="Lịch sử khám" styleClass="page-title"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="10" styleClass="center-pane">
            <HBox spacing="8" alignment="CENTER_LEFT">
                <TextField fx:id="txt_tim" prefWidth="320" promptText="Nhập mã BN, tên hoặc SĐT bệnh nhân"/>
                <Button text="Tìm kiếm" onAction="#tim" styleClass="btn-primary" defaultButton="true"/>
                <Button text="Tất cả" onAction="#tatCa"/>
            </HBox>
            <VBox styleClass="card" spacing="6">
                <Label text="LỊCH SỬ KHÁM" styleClass="card-title"/>
                <TableView fx:id="table_lichSu" prefHeight="440" VBox.vgrow="ALWAYS">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="cl_ma" text="Mã lượt khám" prefWidth="130"/>
                        <TableColumn fx:id="cl_bn" text="Bệnh nhân" prefWidth="200"/>
                        <TableColumn fx:id="cl_ngay" text="Ngày khám" prefWidth="100"/>
                        <TableColumn fx:id="cl_bs" text="Bác sĩ" prefWidth="150"/>
                        <TableColumn fx:id="cl_noiDung" text="Nội dung" prefWidth="260"/>
                        <TableColumn fx:id="cl_tt" text="Trạng thái" prefWidth="110"/>
                    </columns>
                </TableView>
            </VBox>
            <Label text="Double-click một dòng để xem chẩn đoán - kết quả điều trị chi tiết." styleClass="hint-text"/>
        </VBox>
    </center>
</BorderPane>
